# =============================================================================
# Rayvo Game Backend - Environment Configuration
# Copy to .env for local development. Use Render/Supabase env vars in production.
# =============================================================================

# Server
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000
ADMIN_DASHBOARD_URL=http://localhost:5173
TRUST_PROXY_HOPS=0

# Database (Supabase PostgreSQL or local Docker)
DATABASE_URL=postgresql://rayvo:rayvo_dev_password@localhost:5432/rayvo

# Redis (local Docker or Upstash free tier)
REDIS_URL=redis://localhost:6379

# Security secrets - CHANGE IN PRODUCTION (min 32 chars each)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-characters-long
SESSION_SECRET=change-me-session-secret-min-32-characters-long
API_KEY_SALT=change-me-api-key-salt-min-32-characters-long
GAME_SERVER_API_KEY=
PHOTON_AUTH_SECRET=change-me-photon-auth-secret-min-32-chars
ADMIN_TOTP_ISSUER=RayvoAdmin

# Token lifetimes
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Photon - SEPARATE App IDs (never substitute one for the other)
PHOTON_REALTIME_APP_ID=
PHOTON_VOICE_APP_ID=
PHOTON_REGION=us
PHOTON_APP_VERSION=1.0

# Worker
WORKER_CONCURRENCY=5

# Logging
LOG_LEVEL=info
