{
  "name": "rayvo-game-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted game backend with PlayFab-like functionality for Unity + Photon",
  "workspaces": [
    "backend",
    "admin-dashboard",
    "worker"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=backend",
    "dev:admin": "npm run dev --workspace=admin-dashboard",
    "dev:worker": "npm run dev --workspace=worker",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspace=backend",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "@types/express": "4.17.25",
    "@types/express-serve-static-core": "4.19.9"
  }
}
